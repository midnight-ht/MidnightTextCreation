{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ai_slop_score": {
      "type": "number"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "rewrite",
        "human_review"
      ]
    },
    "main_problem": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "why_it_feels_ai": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "severity",
          "evidence",
          "why_it_feels_ai",
          "fix"
        ]
      }
    },
    "keep": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rewrite_brief": {
      "type": "string"
    }
  },
  "required": [
    "ai_slop_score",
    "verdict",
    "main_problem",
    "issues",
    "rewrite_brief"
  ]
}
